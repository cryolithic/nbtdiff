<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NbtDiff.App.ViewModels"
             xmlns:svc="using:NbtDiff.App.Services"
             xmlns:conv="using:NbtDiff.App.Converters"
             xmlns:ctl="using:NbtDiff.App.Controls"
             x:Class="NbtDiff.App.Views.FolderCompareView"
             x:DataType="vm:FolderCompareViewModel">

  <UserControl.Resources>
    <conv:StatusDecorationConverter x:Key="StatusDecoration" />
    <conv:DepthToMarginConverter x:Key="DepthToMargin" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="DataGridRow">
      <Setter Property="Background" Value="{ReflectionBinding Tint, Converter={x:Static conv:StateBrushConverter.Instance}}" />
      <Setter Property="ToolTip.Tip" Value="{ReflectionBinding ToolTipText}" />
    </Style>
    <Style Selector="Button.expander">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="TextBlock.date">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="TextBlock.older">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- Path bar -->
    <Border DockPanel.Dock="Top" Classes="bar" Padding="10,8">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,8,Auto,8,*,Auto,12,Auto,6,Auto,6,Auto">
          <TextBox Grid.Column="0" Classes="mono" Text="{Binding LeftPath}" PlaceholderText="Left folder or file" FontFamily="JetBrains Mono, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
          <Button Grid.Column="1" Content="…" Margin="4,0,0,0" ToolTip.Tip="Browse for the left folder or file">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Folder…" Command="{Binding BrowseLeftFolderCommand}" />
                <MenuItem Header="File…" Command="{Binding BrowseLeftFileCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="3" Content="⇄" Command="{Binding SwapCommand}" ToolTip.Tip="Swap left and right" />
          <TextBox Grid.Column="5" Text="{Binding RightPath}" PlaceholderText="Right folder or file" FontFamily="JetBrains Mono, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
          <Button Grid.Column="6" Content="…" Margin="4,0,0,0" ToolTip.Tip="Browse for the right folder or file">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Folder…" Command="{Binding BrowseRightFolderCommand}" />
                <MenuItem Header="File…" Command="{Binding BrowseRightFileCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="8" Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Grid.Column="10" Content="Compare" Command="{Binding CompareCommand}" Classes="primary" Padding="16,5" />
          <ComboBox Grid.Column="12" MinWidth="110" MaxWidth="360"
                    PlaceholderText="Recent" IsEnabled="{Binding HasRecent}"
                    ItemsSource="{Binding RecentPairs}" SelectedItem="{Binding SelectedRecent}"
                    ToolTip.Tip="Recently compared pairs">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:RecentPair">
                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <!-- Filters (left) and options, tree and export (right) on one row -->
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
            <Button ToolTip.Tip="Deep verify, list matching and ignored tags. Take effect on the next compare.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Compare options" VerticalAlignment="Center" />
                <TextBlock Classes="muted small" Text="{Binding OptionsSummary}" VerticalAlignment="Center" />
                <TextBlock Classes="muted" Text="⌄" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="10" Width="360" Margin="4">
                    <CheckBox Content="Deep verify" IsChecked="{Binding DeepVerify}"
                              ToolTip.Tip="Parse files whose bytes differ, so recompression is not reported as a change" />
                    <CheckBox Content="Match list items by key" IsChecked="{Binding UseKeyedAligner}"
                              ToolTip.Tip="Pair entities by UUID, block entities by position, items by id, so a reordered list is not a difference" />
                    <StackPanel Spacing="4">
                      <TextBlock Text="Ignore tags" />
                      <TextBox Text="{Binding IgnoredTagsText}"
                               ToolTip.Tip="Tag paths that are not content, comma-separated. Default LastUpdate (the chunk save tick Minecraft rewrites on every save). Lists are transparent; * matches one key." />
                      <TextBlock Classes="muted small" TextWrapping="Wrap"
                                 Text="Comma-separated tag paths that are not content. Takes effect on the next compare." />
                    </StackPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Border Classes="divider" />
            <Button Classes="icon" Content="⇕" Command="{Binding ExpandAllCommand}" ToolTip.Tip="Expand all" />
            <Button Classes="icon" Content="⇳" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse all" />
            <Button Content="Export ⌄" Command="{Binding ExportCommand}" CommandParameter="text" ToolTip.Tip="Export the compare as a report">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Text report…" Command="{Binding ExportCommand}" CommandParameter="text" />
                  <MenuItem Header="JSON report…" Command="{Binding ExportCommand}" CommandParameter="json" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <Border Classes="segmented" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <RadioButton GroupName="filter" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RowFilter.All}"
                           IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="All" />
                  <TextBlock Classes="dim small mono" Text="{Binding Counts.Total, Converter={x:Static conv:Conv.Count}}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="filter" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RowFilter.Differences}"
                           IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Differences, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                  <Border Classes="swatch" Background="{DynamicResource State.Different}" />
                  <TextBlock Text="Differences" Margin="0,0,6,0" />
                  <TextBlock Classes="dim small mono" Text="{Binding DifferencesCount, Converter={x:Static conv:Conv.Count}}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="filter" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RowFilter.LeftOnly}"
                           IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=LeftOnly, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                  <Border Classes="swatch" Background="{DynamicResource State.LeftOnly}" />
                  <TextBlock Text="Left only" Margin="0,0,6,0" />
                  <TextBlock Classes="dim small mono" Text="{Binding Counts.LeftOnly, Converter={x:Static conv:Conv.Count}}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="filter" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RowFilter.RightOnly}"
                           IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=RightOnly, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                  <Border Classes="swatch" Background="{DynamicResource State.RightOnly}" />
                  <TextBlock Text="Right only" Margin="0,0,6,0" />
                  <TextBlock Classes="dim small mono" Text="{Binding Counts.RightOnly, Converter={x:Static conv:Conv.Count}}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="filter" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RowFilter.Same}"
                           IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Same, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                  <Border Classes="swatch" Background="{DynamicResource State.Same}" />
                  <TextBlock Text="Same" Margin="0,0,6,0" />
                  <TextBlock Classes="dim small mono" Text="{Binding Counts.Same, Converter={x:Static conv:Conv.Count}}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="filter" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RowFilter.Errors}"
                           IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Errors, Mode=OneWay}"
                           ToolTip.Tip="Files unreadable on either side">
                <StackPanel Orientation="Horizontal">
                  <Border Classes="swatch" Background="{DynamicResource State.Error}" />
                  <TextBlock Text="Errors" Margin="0,0,6,0" />
                  <TextBlock Classes="dim small mono" Text="{Binding Counts.Error, Converter={x:Static conv:Conv.Count}}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
        </DockPanel>

        <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </Border>

    <!-- Status bar: counts as chips, then the labelled pass and progress -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsScanning}">
          <TextBlock Classes="muted" Text="{Binding PassText}" VerticalAlignment="Center" />
          <ProgressBar Width="220" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" VerticalAlignment="Center" />
          <TextBlock Classes="mono small" Text="{Binding ProgressFraction, StringFormat={}{0:P0}}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding PassText}" VerticalAlignment="Center" IsVisible="{Binding !IsScanning}" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <StackPanel Orientation="Horizontal" IsVisible="{Binding Counts.Different, Converter={x:Static conv:Conv.Positive}}">
            <Border Classes="swatch" Background="{DynamicResource State.Different}" />
            <TextBlock FontWeight="SemiBold" Text="{Binding Counts.Different, Converter={x:Static conv:Conv.Count}}" Margin="0,0,4,0" />
            <TextBlock Text="differ" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" IsVisible="{Binding Counts.ProbablyDifferent, Converter={x:Static conv:Conv.Positive}}">
            <Border Classes="swatch" BorderBrush="{DynamicResource State.Different}" BorderThickness="1" />
            <TextBlock FontWeight="SemiBold" Text="{Binding Counts.ProbablyDifferent, Converter={x:Static conv:Conv.Count}}" Margin="0,0,4,0" />
            <TextBlock Text="probably differ" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" IsVisible="{Binding Counts.LeftOnly, Converter={x:Static conv:Conv.Positive}}">
            <Border Classes="swatch" Background="{DynamicResource State.LeftOnly}" />
            <TextBlock FontWeight="SemiBold" Text="{Binding Counts.LeftOnly, Converter={x:Static conv:Conv.Count}}" Margin="0,0,4,0" />
            <TextBlock Text="left only" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" IsVisible="{Binding Counts.RightOnly, Converter={x:Static conv:Conv.Positive}}">
            <Border Classes="swatch" Background="{DynamicResource State.RightOnly}" />
            <TextBlock FontWeight="SemiBold" Text="{Binding Counts.RightOnly, Converter={x:Static conv:Conv.Count}}" Margin="0,0,4,0" />
            <TextBlock Text="right only" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" IsVisible="{Binding Counts.Error, Converter={x:Static conv:Conv.Positive}}">
            <Border Classes="swatch" Background="{DynamicResource State.Error}" />
            <TextBlock FontWeight="SemiBold" Text="{Binding Counts.Error, Converter={x:Static conv:Conv.Count}}" Margin="0,0,4,0" />
            <TextBlock Text="unreadable" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" IsVisible="{Binding Counts.Same, Converter={x:Static conv:Conv.Positive}}">
            <TextBlock FontWeight="SemiBold" Text="{Binding Counts.Same, Converter={x:Static conv:Conv.Count}}" Margin="0,0,4,0" />
            <TextBlock Text="same" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" IsVisible="{Binding Counts.Pending, Converter={x:Static conv:Conv.Positive}}">
            <TextBlock FontWeight="SemiBold" Text="{Binding Counts.Pending, Converter={x:Static conv:Conv.Count}}" Margin="0,0,4,0" />
            <TextBlock Text="pending" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding StatusText}" IsVisible="{Binding !HasResult}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Both panes in one grid: identical row set, so scroll and expansion are inherently in sync -->
    <DataGrid x:Name="Grid"
              ItemsSource="{Binding Tree.Rows}"
              SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserSortColumns="False"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              SelectionMode="Single"
              HeadersVisibility="Column"
              GridLinesVisibility="None"
              RowHeight="27">
      <DataGrid.Columns>

        <DataGridTemplateColumn Header="Left" Width="3*" x:DataType="vm:CompareRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompareRowItem">
              <Panel>
                <ctl:Hatch IsVisible="{Binding !HasLeft}" />
                <StackPanel Orientation="Horizontal" IsVisible="{Binding HasLeft}" Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">
                  <Button Classes="expander" Content="{Binding ExpanderGlyph}"
                          Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).ToggleCommand}"
                          CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                             TextDecorations="{Binding Status, Converter={StaticResource StatusDecoration}}" />
                  <TextBlock Classes="muted small" Text="{Binding InlineCounts}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Size" Width="80" x:DataType="vm:CompareRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompareRowItem">
              <Panel>
                <ctl:Hatch IsVisible="{Binding !HasLeft}" />
                <TextBlock Classes="mono small num" Text="{Binding LeftSizeText}" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Modified" Width="150" x:DataType="vm:CompareRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompareRowItem">
              <Panel>
                <ctl:Hatch IsVisible="{Binding !HasLeft}" />
                <TextBlock Classes="mono small date" Classes.older="{Binding RightIsNewer}" Text="{Binding LeftModifiedText}" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="" Width="44" x:DataType="vm:CompareRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompareRowItem">
              <ctl:StateChip State="{Binding State}" Glyph="{Binding StatusGlyph}" Rollup="{Binding IsRollup}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Right" Width="3*" x:DataType="vm:CompareRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompareRowItem">
              <Panel>
                <ctl:Hatch IsVisible="{Binding !HasRight}" />
                <StackPanel Orientation="Horizontal" IsVisible="{Binding HasRight}" Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">
                  <Button Classes="expander" Content="{Binding ExpanderGlyph}"
                          Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).ToggleCommand}"
                          CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                             TextDecorations="{Binding Status, Converter={StaticResource StatusDecoration}}" />
                </StackPanel>
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Size" Width="80" x:DataType="vm:CompareRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompareRowItem">
              <Panel>
                <ctl:Hatch IsVisible="{Binding !HasRight}" />
                <TextBlock Classes="mono small num" Text="{Binding RightSizeText}" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Modified" Width="150" x:DataType="vm:CompareRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompareRowItem">
              <Panel>
                <ctl:Hatch IsVisible="{Binding !HasRight}" />
                <TextBlock Classes="mono small date" Classes.older="{Binding LeftIsNewer}" Text="{Binding RightModifiedText}" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
