<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NbtDiff.App.ViewModels"
             xmlns:svc="using:NbtDiff.App.Services"
             xmlns:conv="using:NbtDiff.App.Converters"
             x:Class="NbtDiff.App.Views.FolderCompareView"
             x:DataType="vm:FolderCompareViewModel">

  <UserControl.Resources>
    <conv:StatusBackgroundConverter x:Key="StatusBackground" />
    <conv:StatusDecorationConverter x:Key="StatusDecoration" />
    <conv:StatusOpacityConverter x:Key="StatusOpacity" />
    <conv:DepthToMarginConverter x:Key="DepthToMargin" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="DataGridRow">
      <Setter Property="Background" Value="{ReflectionBinding Status, Converter={StaticResource StatusBackground}}" />
      <Setter Property="ToolTip.Tip" Value="{ReflectionBinding ToolTipText}" />
    </Style>
    <Style Selector="Button.expander">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="RadioButton.chip">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.placeholder">
      <Setter Property="Opacity" Value="0.35" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4" Spacing="6">
      <Grid ColumnDefinitions="*,Auto,12,*,Auto,12,Auto,Auto,Auto" RowDefinitions="Auto">
        <TextBox Grid.Column="0" Text="{Binding LeftPath}" PlaceholderText="Left folder" />
        <Button Grid.Column="1" Content="…" Margin="4,0,0,0" Command="{Binding BrowseLeftCommand}" ToolTip.Tip="Browse for the left folder" />
        <TextBox Grid.Column="3" Text="{Binding RightPath}" PlaceholderText="Right folder" />
        <Button Grid.Column="4" Content="…" Margin="4,0,0,0" Command="{Binding BrowseRightCommand}" ToolTip.Tip="Browse for the right folder" />
        <Button Grid.Column="6" Content="Compare" Command="{Binding CompareCommand}" Classes="accent" />
        <Button Grid.Column="7" Content="Cancel" Margin="4,0,0,0" Command="{Binding CancelCommand}" />
        <ComboBox Grid.Column="8" Margin="4,0,0,0" MinWidth="110" MaxWidth="360"
                  PlaceholderText="Recent…" IsEnabled="{Binding HasRecent}"
                  ItemsSource="{Binding RecentPairs}" SelectedItem="{Binding SelectedRecent}"
                  ToolTip.Tip="Recently compared folder pairs">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="svc:RecentPair">
              <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <WrapPanel ItemSpacing="4" LineSpacing="4">
        <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,6,0" />
        <RadioButton Classes="chip" GroupName="filter" Content="All"
                     IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All, Mode=OneWay}"
                     Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RowFilter.All}" />
        <RadioButton Classes="chip" GroupName="filter" Content="Differences"
                     IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Differences, Mode=OneWay}"
                     Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RowFilter.Differences}" />
        <RadioButton Classes="chip" GroupName="filter" Content="Same"
                     IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Same, Mode=OneWay}"
                     Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RowFilter.Same}" />
        <RadioButton Classes="chip" GroupName="filter" Content="Orphans"
                     IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Orphans, Mode=OneWay}"
                     Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RowFilter.Orphans}" />
        <RadioButton Classes="chip" GroupName="filter" Content="Errors"
                     IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Errors, Mode=OneWay}"
                     Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RowFilter.Errors}"
                     ToolTip.Tip="Files unreadable on either side" />
        <Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="6,2" />
        <CheckBox Content="Deep verify" IsChecked="{Binding DeepVerify}" ToolTip.Tip="Parse files whose bytes differ, so recompression is not reported as a change" />
        <CheckBox Content="Match list items by key" IsChecked="{Binding UseKeyedAligner}"
                  ToolTip.Tip="Pair entities by UUID, block entities by position, items by id, so a reordered list is not a difference. Applies to the scan, the chunk grid and the tag views." />
        <TextBlock Text="Ignore tags:" VerticalAlignment="Center" Margin="4,0,0,0" />
        <TextBox Text="{Binding IgnoredTagsText}" Width="220" VerticalAlignment="Center"
                 ToolTip.Tip="Tag paths that are not content, comma-separated. Default LastUpdate (the chunk save tick Minecraft rewrites on every save). Lists are transparent; * matches one key. Takes effect on the next compare." />
        <Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="6,2" />
        <Button Content="Expand all" Command="{Binding ExpandAllCommand}" />
        <Button Content="Collapse all" Command="{Binding CollapseAllCommand}" />
        <Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="6,2" />
        <Button Content="Export text" Command="{Binding ExportCommand}" CommandParameter="text" />
        <Button Content="Export JSON" Command="{Binding ExportCommand}" CommandParameter="json" />
      </WrapPanel>

      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="#E04040" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Status bar -->
    <DockPanel DockPanel.Dock="Bottom" Margin="8,4,8,6">
      <ProgressBar DockPanel.Dock="Right" Width="160" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" IsVisible="{Binding IsScanning}" Margin="8,0,0,0" />
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <!-- Both panes in one grid: identical row set, so scroll and expansion are inherently in sync -->
    <DataGrid x:Name="Grid"
              ItemsSource="{Binding Tree.Rows}"
              SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserSortColumns="False"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              SelectionMode="Single"
              HeadersVisibility="Column"
              GridLinesVisibility="Vertical"
              RowHeight="24"
              Margin="8,0">
      <DataGrid.Columns>

        <DataGridTemplateColumn Header="Left" Width="3*" x:DataType="vm:CompareRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompareRowItem">
              <Panel Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">
                <StackPanel Orientation="Horizontal" IsVisible="{Binding HasLeft}">
                  <Button Classes="expander" Content="{Binding ExpanderGlyph}"
                          Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).ToggleCommand}"
                          CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                             TextDecorations="{Binding Status, Converter={StaticResource StatusDecoration}}" />
                </StackPanel>
                <TextBlock Classes="placeholder" Text="—" IsVisible="{Binding !HasLeft}" Margin="20,0,0,0" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Size" Width="80" Binding="{Binding LeftSizeText}" x:DataType="vm:CompareRowItem" />
        <DataGridTextColumn Header="Modified" Width="180" Binding="{Binding LeftModifiedText}" x:DataType="vm:CompareRowItem" />

        <DataGridTemplateColumn Header="" Width="36" x:DataType="vm:CompareRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompareRowItem">
              <TextBlock Text="{Binding StatusGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"
                         Opacity="{Binding Status, Converter={StaticResource StatusOpacity}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Right" Width="3*" x:DataType="vm:CompareRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompareRowItem">
              <Panel Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">
                <StackPanel Orientation="Horizontal" IsVisible="{Binding HasRight}">
                  <Button Classes="expander" Content="{Binding ExpanderGlyph}"
                          Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).ToggleCommand}"
                          CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                             TextDecorations="{Binding Status, Converter={StaticResource StatusDecoration}}" />
                </StackPanel>
                <TextBlock Classes="placeholder" Text="—" IsVisible="{Binding !HasRight}" Margin="20,0,0,0" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Size" Width="80" Binding="{Binding RightSizeText}" x:DataType="vm:CompareRowItem" />
        <DataGridTextColumn Header="Modified" Width="180" Binding="{Binding RightModifiedText}" x:DataType="vm:CompareRowItem" />

      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
