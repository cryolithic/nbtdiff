<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NbtDiff.App.ViewModels"
             x:Class="NbtDiff.App.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="640">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" />
    <TextBlock Text="⚠" FontSize="28" HorizontalAlignment="Center" Foreground="#E04040" IsVisible="{Binding IsError}" />
  </StackPanel>
</UserControl>
