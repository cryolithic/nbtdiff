<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NbtDiff.App.ViewModels"
             xmlns:conv="using:NbtDiff.App.Converters"
             x:Class="NbtDiff.App.Views.TextCompareView"
             x:DataType="vm:TextCompareViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="F7" Command="{Binding PreviousHunkCommand}" />
    <KeyBinding Gesture="F8" Command="{Binding NextHunkCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="DataGrid#Grid DataGridRow">
      <Setter Property="Background" Value="{ReflectionBinding Tint, Converter={x:Static conv:StateBrushConverter.Instance}}" />
    </Style>
    <Style Selector="TextBlock.code">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.lineno">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Classes="bar" Padding="10,8">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="↑  Previous hunk" Command="{Binding PreviousHunkCommand}" ToolTip.Tip="Previous hunk (F7)" />
          <Button Content="↓  Next hunk" Command="{Binding NextHunkCommand}" ToolTip.Tip="Next hunk (F8)" />
          <Border Classes="divider" />
          <TextBlock Classes="muted mono small" Text="{Binding LeftPathText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip.Tip="{Binding LeftPathText}" />
          <TextBlock Classes="dim" Text="↔" VerticalAlignment="Center" />
          <TextBlock Classes="muted mono small" Text="{Binding RightPathText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip.Tip="{Binding RightPathText}" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
        <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <TextBlock Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis" />
    </Border>

    <DataGrid x:Name="Grid"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserSortColumns="False"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              SelectionMode="Single"
              HeadersVisibility="Column"
              GridLinesVisibility="Vertical"
              RowHeight="22"
              Margin="8,0">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="56" x:DataType="vm:TextDiffRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TextDiffRowItem">
              <TextBlock Classes="lineno" Text="{Binding LeftLineText}" Margin="0,0,6,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Left" Width="*" x:DataType="vm:TextDiffRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TextDiffRowItem">
              <TextBlock Classes="code" Text="{Binding LeftText}" ToolTip.Tip="{Binding LeftText}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="36" x:DataType="vm:TextDiffRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TextDiffRowItem">
              <TextBlock Text="{Binding StatusGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="56" x:DataType="vm:TextDiffRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TextDiffRowItem">
              <TextBlock Classes="lineno" Text="{Binding RightLineText}" Margin="0,0,6,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Right" Width="*" x:DataType="vm:TextDiffRowItem">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TextDiffRowItem">
              <TextBlock Classes="code" Text="{Binding RightText}" ToolTip.Tip="{Binding RightText}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
