<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NbtDiff.App.ViewModels"
        x:Class="NbtDiff.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/nbtdiff-256.png"
        Width="1200" Height="720"
        MinWidth="640" MinHeight="400">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <!-- Breadcrumb bar (#13): Back, the path through the navigation stack, and a slot for the current view. -->
    <Border DockPanel.Dock="Top" Classes="bar" IsVisible="{Binding CanGoBack}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Classes="icon" Content="‹" FontSize="18" Command="{Binding BackCommand}"
                ToolTip.Tip="Back (Esc)" Margin="0,0,10,0" />
        <!-- Right: whatever the current view puts there (the tag view's changed-chunk stepper). -->
        <ContentControl DockPanel.Dock="Right" Content="{Binding Current}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:FileCompareViewModel">
              <Border Classes="segmented" IsVisible="{Binding HasChunkNavigation}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="‹" Command="{Binding PreviousChunkCommand}" ToolTip.Tip="Previous changed chunk (Ctrl+F7)" />
                  <TextBlock Text="{Binding ChunkPositionText}" VerticalAlignment="Center" Margin="6,0" />
                  <Button Content="›" Command="{Binding NextChunkCommand}" ToolTip.Tip="Next changed chunk (Ctrl+F8)" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:ViewModelBase">
              <Panel />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding Crumbs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:Crumb">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="dim" Text="/" Margin="8,0" VerticalAlignment="Center" IsVisible="{Binding !IsFirst}" />
                  <Button Classes="crumb" Content="{Binding Label}" IsVisible="{Binding !IsCurrent}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToCommand}"
                          CommandParameter="{Binding Level}" />
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted small" Text="{Binding Current.CrumbNote}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
    <ContentControl Content="{Binding Current}" />
  </DockPanel>
</Window>
