<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NbtDiff.App.ViewModels"
        x:Class="NbtDiff.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1200" Height="720"
        MinWidth="640" MinHeight="400">
  <DockPanel>
    <Border DockPanel.Dock="Top" IsVisible="{Binding CanGoBack}" Padding="8,4"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="◀ Back" Command="{Binding BackCommand}" />
        <TextBlock Text="{Binding Current.Title}" VerticalAlignment="Center" FontWeight="SemiBold" />
      </StackPanel>
    </Border>
    <ContentControl Content="{Binding Current}" />
  </DockPanel>
</Window>
